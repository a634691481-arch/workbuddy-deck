{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Deck",
  "version": "0.1.12",
  "identifier": "com.wbswitch.taskassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy 任务助手",
        "width": 1120,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENDU1MEM3NUM1RENBNTYKUldSV3lsMWN4MUJGUFpMejh0YXJ0S2hMZVJ5K0Uyd1lGNkNRRkJLdmVTN0lOT3Buang5YnQyRVQK",
      "endpoints": [
        "https://github.com/a634691481-arch/workbuddy-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
