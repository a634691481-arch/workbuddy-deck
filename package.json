{
  "name": "workbuddy-task-assistant",
  "private": true,
  "version": "0.1.29",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "deck": "node scripts/deck.mjs",
    "deck:inject": "node scripts/deck.mjs --inject",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bump": "node scripts/bump.mjs",
    "verify": "vue-tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "installer": "node scripts/installer.mjs",
    "clean:dev": "cargo clean --profile dev --manifest-path src-tauri/Cargo.toml && cargo clean --profile dev --manifest-path crates/wb-switch-core/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@formkit/auto-animate": "^0.10.0",
    "@lordicon/element": "^3.0.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^1.66.0",
    "lucide-vue-next": "^0.468.0",
    "morphicons": "^2.0.2",
    "tailwind-merge": "^2.5.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
